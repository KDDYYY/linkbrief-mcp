{
  "name": "linkbrief-mcp",
  "mcpName": "io.github.KDDYYY/linkbrief-mcp",
  "version": "0.3.0",
  "description": "MCP server that lets Claude, Codex and other agents read any link — web pages, PDFs, JavaScript pages — as clean Markdown from your own computer, with ~95% fewer tokens than raw HTML. Handles any language and legacy encodings.",
  "type": "module",
  "bin": {
    "linkbrief-mcp": "server.mjs"
  },
  "files": [
    "server.mjs",
    "page.mjs",
    "browser.mjs",
    "office.mjs",
    "robots.mjs",
    "sites.mjs"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node test.mjs",
    "check:live": "node scripts/live-check.mjs",
    "build:mcpb": "node scripts/build-mcpb.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "claude",
    "claude-code",
    "codex",
    "ai-agent",
    "fetch",
    "web-fetch",
    "pdf",
    "readability",
    "markdown",
    "summarize",
    "headless",
    "naver",
    "korean",
    "japanese",
    "chinese"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KDDYYY/linkbrief-mcp.git"
  },
  "homepage": "https://github.com/KDDYYY/linkbrief-mcp#readme",
  "bugs": "https://github.com/KDDYYY/linkbrief-mcp/issues",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@mozilla/readability": "^0.6.0",
    "fflate": "^0.8.3",
    "linkedom": "^0.18.15",
    "turndown": "^7.2.5",
    "unpdf": "1.9.1",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "puppeteer-core": "25.19.0"
  }
}
