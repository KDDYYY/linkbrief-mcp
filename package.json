{
  "name": "linkbrief-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets Claude read web pages from your own PC — tuned for Korean sites (Naver blog, Daum, Tistory, Brunch) and legacy charsets (EUC-KR, Shift_JIS, GBK).",
  "type": "module",
  "bin": {
    "linkbrief-mcp": "server.mjs"
  },
  "files": [
    "server.mjs",
    "page.mjs",
    "browser.mjs",
    "sites.mjs"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node test.mjs",
    "check:live": "node scripts/live-check.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "fetch",
    "readability",
    "markdown",
    "naver",
    "korean"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KDDYYY/linkbrief-mcp.git"
  },
  "homepage": "https://github.com/KDDYYY/linkbrief-mcp#readme",
  "bugs": "https://github.com/KDDYYY/linkbrief-mcp/issues",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.15",
    "turndown": "^7.2.5",
    "unpdf": "1.9.1",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "puppeteer-core": "25.19.0"
  }
}
